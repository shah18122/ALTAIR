{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Dev \u2014 RelWithDebInfo, tests. No vcpkg needed until P0-03.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ALTAIR_BUILD_TESTS": "ON",
        "ALTAIR_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "displayName": "Dev + vcpkg \u2014 needed from P0-03 onward",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "config",
        "ALTAIR_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug \u2014 full invariants",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALTAIR_BUILD_TESTS": "ON",
        "ALTAIR_STRICT_INVARIANTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + Address/UB sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALTAIR_ENABLE_ASAN": "ON",
        "ALTAIR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + Thread sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALTAIR_ENABLE_TSAN": "ON",
        "ALTAIR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "prod",
      "displayName": "Production \u2014 Release, native arch, invariants ON, no test binaries",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ALTAIR_BUILD_TESTS": "OFF",
        "ALTAIR_BUILD_BENCH": "OFF",
        "ALTAIR_NATIVE_ARCH": "ON",
        "ALTAIR_STRICT_INVARIANTS": "ON"
      }
    },
    {
      "name": "net",
      "displayName": "Dev + vcpkg net - HTTPS/TLS, needed from P2-10c",
      "inherits": "vcpkg",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "config;net"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "prod",
      "configurePreset": "prod"
    },
    {
      "name": "net",
      "configurePreset": "net",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 600
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 600
      }
    },
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 600
      }
    },
    {
      "name": "net",
      "configurePreset": "net",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 600
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 600
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "timeout": 600
      }
    }
  ]
}
