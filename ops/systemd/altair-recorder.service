[Unit]
Description=ALTAIR: record the FYERS session (ticks, quotes, books) to data/store/tapes
After=network-online.target time-sync.target
# Ordering only: wait for a login or a DPDK bind that is still running at boot
# or at 08:50 (both are oneshot), never pull them in.
After=altair-fyers-login.service altair-dpdk-bind.service altair-nic-tune.service
Wants=network-online.target time-sync.target

[Service]
Type=exec
Slice=altair.slice
TimerSlackNSec=1
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/altair/altair.env
ExecStart=/usr/bin/python3 @ROOT@/ops/linux/record_session.py --go
TimeoutStopSec=60
RuntimeMaxSec=8h
LimitMEMLOCK=infinity
LimitRTPRIO=50
LimitNICE=-10
# For the feed over kernel bypass (ops/linux/feed_bypass.sh): load and attach
# the XDP filter (CAP_PERFMON: the verifier refuses its packet-pointer code
# without it), open AF_XDP sockets. Unused while the bypass is off.
# For the feed on a DPDK port (ALTAIR_FEED_DPDK_*): vfio in no-IOMMU mode
# (CAP_SYS_RAWIO), physical addresses of its hugepages (CAP_SYS_ADMIN reads
# /proc/self/pagemap) and locking them (CAP_IPC_LOCK). /dev/vfio is handed to
# the service user by altair-dpdk-bind. Unused while no DPDK port is set.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_PERFMON CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_IPC_LOCK
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
