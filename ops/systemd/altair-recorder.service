[Unit]
Description=ALTAIR: record the FYERS session (ticks, quotes, books) to data/store/tapes
After=network-online.target time-sync.target
# Ordering only: wait for a login or a DPDK bind that is still running at boot
# or at 08:50 (both are oneshot), never pull them in.
After=altair-fyers-login.service altair-dpdk-bind.service
Wants=network-online.target

[Service]
Type=exec
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/altair/altair.env
ExecStart=/usr/bin/python3 @ROOT@/ops/linux/record_session.py --go
TimeoutStopSec=60
RuntimeMaxSec=8h
LimitMEMLOCK=infinity
LimitRTPRIO=50
LimitNICE=-10
# For the feed over kernel bypass (ops/linux/feed_bypass.sh): load and attach
# the XDP filter (CAP_PERFMON: the verifier refuses its packet-pointer code
# without it), open AF_XDP sockets. Unused while the bypass is off.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
