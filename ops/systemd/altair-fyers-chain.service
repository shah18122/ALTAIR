[Unit]
Description=ALTAIR: save the NIFTY/BANKNIFTY chains from FYERS history
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=exec
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/altair/altair.env
ExecStart=/usr/bin/python3 @ROOT@/ops/linux/fyers_chain.py --go
TimeoutStopSec=60
RuntimeMaxSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
