# config/fyers_login.example.env -- TEMPLATE for the FYERS auto-login.
#
# Copy to config/fyers_login.local.env (gitignored) ONLY if you do not want to
# use the OS vault. The vault is better on a PC:
#     python broker\tools\fyers_auto_login.py --store
# Environment variables of the same names win over both (handy on a server).
# Never put real values in this template, and never commit the .local file.

ALTAIR_FYERS_CLIENT_ID=        # app id from myapi.fyers.in, e.g. ABCD1234-100
ALTAIR_FYERS_SECRET=           # app secret
ALTAIR_FYERS_REDIRECT_URI=     # redirect uri registered on the app (blank = ALTAIR's default)
ALTAIR_FYERS_FY_ID=            # FYERS login id, e.g. XS12345
ALTAIR_FYERS_PIN=              # 4-digit PIN
ALTAIR_FYERS_TOTP_KEY=         # base32 TOTP key shown when "External 2FA TOTP" was enabled
